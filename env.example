# Copy to .env, fill in, then: docker compose --profile stack up -d --build
# Walkthrough: docs/deploying/LOCAL.md. Generate secrets with: openssl rand -hex 32

# Bearer token for the MCP stream + REST API. Required.
MCP_BEARER_TOKEN=replace-me

# Optional access key that gates the public /img photo proxy. When set, image
# URLs must carry ?k=<this> — which the MCP tools and console append for you, so
# hosted galleries/artifacts keep working — turning the proxy from an anonymous,
# enumerable photo rehost into a per-deployment, revocable one. A lesser,
# read-only capability than MCP_BEARER_TOKEN; safe to embed in <img src>. Empty
# leaves the proxy fully public (fine for local dev). Recommended for public deploys.
PUBLIC_IMG_TOKEN=

# Optional server knobs, all forwarded to mcpd when set (defaults in parentheses):
# PUBLIC_BASE_URL=     # origin used to mint photo links (the request's own host)
# URL_TOKEN_AUTH=      # allow ?token= on the MCP endpoint for header-less clients (false)
# CONSOLE_URL=         # hosted console origin returned by get_console_url (unset)
# MIGRATE_ON_START=    # apply migrations at boot (true)

# Secret for the local S3 thumbnail store. Required (access key defaults to "radar").
S3_SECRET_KEY=replace-me

# Residential Webshare key for the crawler; empty = fetch directly (docs/decisions.md).
# https://go.dteather.com/webshare
WEBSHARE_API_KEY=

# Crawler proxy mode for `docker compose --profile crawl`: off (default, direct
# fetch) or split (site pages via the Webshare pool; needs WEBSHARE_API_KEY).
# CRAWL_PROXY_MODE=off

# Rolling-cache window for crawled thumbnails, in days (default 30). The crawler
# evicts the cached photo bytes of any listing not re-verified within this window
# — and immediately when a listing is delisted — so the store is a cache, not a
# growing archive. Set to 0 to disable eviction (keep photos indefinitely).
PHOTO_TTL_DAYS=30

# Optional: comma-separated provider area ids to pre-seed one standing sale
# crawl scope on first boot (e.g. 305,319 for two Brooklyn neighborhoods).
# Empty (default) = start with an empty corpus; the caller LLM queues crawls
# via request_crawl when you tell it what you're interested in.
SEED_CRAWL_AREAS=

# S3_ACCESS_KEY=radar
