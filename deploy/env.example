# Copy to deploy/.env (gitignored) on the VPS and fill in real values.
# Generate both secrets with: openssl rand -hex 32

POSTGRES_PASSWORD=replace-me
MCP_BEARER_TOKEN=replace-me

# Host directory rsynced from the laptop and bind-mounted read-only into mcpd.
THUMBS_HOST_DIR=./thumbs

# Bind mcpd to 127.0.0.1 when a TLS proxy (Caddy) fronts it on the same host;
# leave 0.0.0.0 only if you terminate TLS elsewhere or use Tailscale.
MCP_PUBLISH_ADDR=0.0.0.0

# Gate the public /img photo proxy (recommended before exposing the host):
# image URLs then carry ?k=<token>, which tools and the console add for you.
# PUBLIC_IMG_TOKEN=replace-me

# Accept the bearer token as ?token= too, for URL-only web connectors
# (claude.ai / ChatGPT); the token then shows up in that client's URLs and logs.
# URL_TOKEN_AUTH=true

# Absolute origin for /img links when a proxy hides the real host from mcpd.
# PUBLIC_BASE_URL=https://radar.example.com

# Thumbnail storage.
#
# The canonical deployed shape is S3-compatible object storage
# (STORAGE_BACKEND=s3): it lets the crawler and mcpd run on different machines
# and share one thumbnail cache (docs/decisions.md). The Railway deploy wires
# this to a VersityGW service automatically — see deploy/railway/README.md.
#
# This VPS/compose recipe is the self-host alternative: it defaults to the
# local disk cache (STORAGE_BACKEND=local, THUMBS_DIR, rsynced from the laptop),
# fine when the crawler and mcpd share a host. To point this host at a bucket
# instead, set STORAGE_BACKEND=s3 and the S3_* vars.
# STORAGE_BACKEND=s3
# S3_ENDPOINT=s3.example:9000
# S3_BUCKET=thumbs
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_REGION=us-east-1
# S3_USE_SSL=true

# mcpd applies embedded migrations on startup by default; set false to opt out.
# MIGRATE_ON_START=true
